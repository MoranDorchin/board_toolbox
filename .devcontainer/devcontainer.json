{
  "name": "Rust & Slint Development",
  "image": "://microsoft.com:1-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "slint.slint"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}