import "./assets/CascadiaCodePL.ttf";
import { Button } from "std-widgets.slint";
import { MainMenu, PlaceholderModule } from "./modules/index.slint";
import { Dropdown } from "./dropdown.slint";
import { ModuleMenuBtn } from "buttons/module_menu_option.slint";

//tab
struct TabItem {
    kind: string,
    //todo: add icon
}
export component MainWindow inherits Window {
    min-width: 400px;
    min-height: 300px;
    preferred-width: 800px;
    preferred-height: 600px;
    title: "Board ToolBox - Beta";

    default-font-family: "Cascadia Code PL";

    //tabs
    in-out property <[TabItem]> tabs: [{ kind: "Main Menu" }];
    //tab scrolling
    in-out property <length> tab-scroll-x: 0px;
    animate tab-scroll-x {
        duration: 250ms;
        easing: ease-out;
    }
    //active tab:
    in-out property <int> active-tab-index: 0;
    //tab menu
    in-out property <bool> module-menu-open: false;
    in property <[TabItem]> available-modules: [{ kind: "Main Menu" }, { kind: "Placeholder Module" }];

    callback tab-changed(int);

    callback add-tab(string);
    callback close-tab(int);

    callback undo-clicked();
    callback redo-clicked();

    callback hold_scroll_changed(int);

    FocusScope {
        width: 100%;
        height: 100%;

        //keyboard stuff
        KeyBinding {
            keys: @keys(Control + Z);
            activated => { root.undo-clicked(); }
        }

        KeyBinding {
            keys: @keys(Control + Shift + Z);
            activated => { root.redo-clicked(); }
        }

        //LAYER 1: application stuff
        VerticalLayout {

            Rectangle {
                height: 50px;
                background: #aaaaaa;

                HorizontalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        cross-axis-alignment: CrossAxisAlignment.center;

                        //Placeholder Icon
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: #4caf50;
                        }
                        //Title
                        Text {
                            text: "Board Toolbox";
                            color: #ffffff;
                            font-size: 16px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: LayoutAlignment.center;
                        cross-axis-alignment: CrossAxisAlignment.center;

                        //Placeholder Undo button
                        Button {
                            text: "<-|";
                            width: 40px;
                            height: 30px;
                            clicked => { root.undo-clicked(); }
                        }
                        //Placeholder Redo button
                        Button {
                            text: "|->";
                            width: 40px;
                            height: 30px;
                            clicked => { root.redo-clicked(); }
                        }
                        //Placeholder Plus button
                        plus-btn := Button {
                            text: "+";
                            width: 40px;
                            height: 30px;
                            clicked => {
                                root.module-menu-open = !root.module-menu-open;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                left-btn := Rectangle {
                    width: 25px;
                    background: #aaaaaa;
                    Text {
                        text: "<";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) { root.hold_scroll_changed(-1); }
                            if (event.kind == PointerEventKind.up) { root.hold_scroll_changed(0); }
                        }
                    }
                }
                //tab bar
                scroll-bar := Flickable {
                    horizontal-stretch: 1;
                    height: 35px;
                    interactive: false;
                    content-x: root.tab-scroll-x;

                    bar := HorizontalLayout {
                        height: 35px;
                        alignment: LayoutAlignment.start;
                        cross-axis-alignment: CrossAxisAlignment.center;

                        //placeholder tab
                        for tab[index] in root.tabs: tabrec := Rectangle {
                            height: 35px;

                            background: root.active-tab-index == index ? #1565c0 : #2196f3;  // color change placeholder
                            border-width: root.active-tab-index == index ? 5px : 3px;
                            border-color: root.active-tab-index == index ? #ffffff5d : #ffffff9d;

                            HorizontalLayout {
                                padding-right: tabrec.border-width;
                                cross-axis-alignment: CrossAxisAlignment.center;
                                Rectangle {
                                    width: self.preferred-width - close-btn.width;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        alignment: LayoutAlignment.start;
                                        cross-axis-alignment: CrossAxisAlignment.center;

                                        //placeholder icon
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            background: #4caf50;
                                            border-radius: 2px;
                                        }

                                        Text {
                                            text: tab.kind;
                                            color: #ffffff;
                                            font-size: 10px;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.active-tab-index = index;
                                            root.tab-changed(index);
                                        }
                                    }
                                }

                                close-btn := Rectangle {
                                    background: tabrec.background;
                                    width: self.height;
                                    height: root.active-tab-index == index && root.tabs.length > 1 ? tabrec.height - tabrec.border-width * 2 : 0px;
                                    visible: root.active-tab-index == index && root.tabs.length > 1 ? true : false;
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        background: #ffffff5d;
                                        border-radius: 2px;
                                        visible: close-btn-area.has-hover ? true : false;
                                    }

                                    Text {
                                        text: "X";
                                    }

                                    close-btn-area := TouchArea {
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.up) { root.close-tab(index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                right-btn := Rectangle {
                    width: 25px;
                    background: #aaaaaa;
                    Text {
                        text: ">";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) { root.hold_scroll_changed(1); }
                            if (event.kind == PointerEventKind.up) { root.hold_scroll_changed(0); }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                if root.tabs[root.active-tab-index].kind == "Main Menu": MainMenu { }
                if root.tabs[root.active-tab-index].kind == "Placeholder Module": PlaceholderModule { }
            }
        }
        //LAYER 2: click blocking thing
        if root.module-menu-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.module-menu-open = false;
            }
            Rectangle {
                width: 100%;
                height: 100%;
                background: #8080804e;
            }
        }
        //LAYER 3: floating things
        Dropdown {
            is-open: root.module-menu-open;

            anchor-x: plus-btn.absolute-position.x + plus-btn.width - self.base-width;
            anchor-y: plus-btn.absolute-position.y + plus-btn.height + 4px;
            base-width: 160px;
            base-height: 120px;

            background: #333333;
            border-width: 2px;
            border-color: #555555;

            Flickable {
                width: 100%;
                height: 100%;
                content-height: inner-list.preferred-height;
                content-width: self.width;
                interactive: true;

                inner-list := VerticalLayout {
                    width: 100%;
                    padding: 5px;
                    spacing: 4px;
                    alignment: start;

                    for entry in root.available-modules: ModuleMenuBtn {
                        text: entry.kind;
                        clicked => {
                            root.module-menu-open = false;
                            root.add-tab(entry.kind);
                        }
                    }
                }
            }
        }
    }
}
